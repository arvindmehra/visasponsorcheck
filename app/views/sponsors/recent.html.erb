<% content_for :structured_data do %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "<%= @label %> Sponsors — <%= @last_sync.completed_at.strftime("%-d %B %Y") %> Register Update",
  "description": "<%= number_with_delimiter(@count) %> UK visa sponsor licences were <%= @type %> in the most recent register update.",
  "url": "<%= recent_sponsors_url(type: @type) %>",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "<%= root_url %>" },
      { "@type": "ListItem", "position": 2, "name": "Sponsors", "item": "<%= sponsors_url %>" },
      { "@type": "ListItem", "position": 3, "name": "<%= @label %>", "item": "<%= recent_sponsors_url(type: @type) %>" }
    ]
  }
}
</script>
<% end %>

<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

  <!-- Breadcrumb -->
  <nav class="flex mb-8 text-xs text-slate-500 font-medium uppercase tracking-wider" aria-label="Breadcrumb">
    <%= link_to "Home", root_path, class: "hover:text-indigo-600 transition-colors" %>
    <span class="mx-2 text-slate-300">›</span>
    <%= link_to "Sponsors", sponsors_path, class: "hover:text-indigo-600 transition-colors" %>
    <span class="mx-2 text-slate-300">›</span>
    <span class="text-slate-800"><%= @label %></span>
  </nav>

  <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-3">
    <%= @label %> Sponsors
  </h1>
  <p class="text-lg text-slate-500 mb-10">
    <strong class="text-slate-700"><%= number_with_delimiter(@count) %></strong> licence <%= @count == 1 ? "change" : "changes" %>
    from the register update on <%= @last_sync.completed_at.strftime("%-d %B %Y") %>.
    <%= "Showing page #{@pagy.page} of #{@pagy.last}." if @pagy.last > 1 %>
  </p>

  <%= render partial: "sponsors/event_list", locals: {
        events: @events,
        pagy: @pagy,
        empty_title: "No #{@label.downcase} sponsors in this update",
        empty_message: "The register update on #{@last_sync.completed_at.strftime('%-d %B %Y')} had no #{@type} licences."
      } %>

  <!-- Last 30 Days -->
  <div class="mt-16 border-t border-slate-200 pt-10">
    <h2 class="text-2xl font-bold text-slate-900 mb-3">
      <%= @label %> Sponsors — Last 30 Days
    </h2>
    <p class="text-base text-slate-500 mb-8">
      <strong class="text-slate-700"><%= number_with_delimiter(@last_30_days_count) %></strong> licence <%= @last_30_days_count == 1 ? "change" : "changes" %>
      across every register update in the last 30 days, not just the one above.
      <%= "Showing page #{@last_30_days_pagy.page} of #{@last_30_days_pagy.last}." if @last_30_days_pagy.last > 1 %>
    </p>

    <%= render partial: "sponsors/event_list", locals: {
          events: @last_30_days_events,
          pagy: @last_30_days_pagy,
          empty_title: "No #{@label.downcase} sponsors in the last 30 days",
          empty_message: "There haven't been any #{@type} licences in the last 30 days of register updates."
        } %>
  </div>
</div>

<% content_for :structured_data do %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Visa Sponsors in <%= @city_name %>",
  "description": "<%= number_with_delimiter(@count) %> companies in <%= @city_name %> licensed to sponsor UK work visas.",
  "url": "<%= city_sponsors_url(city: @city_slug) %>",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "<%= root_url %>" },
      { "@type": "ListItem", "position": 2, "name": "Sponsors", "item": "<%= sponsors_url %>" },
      { "@type": "ListItem", "position": 3, "name": "<%= @city_name %>", "item": "<%= city_sponsors_url(city: @city_slug) %>" }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": <%= @count %>,
    "itemListElement": [
      <% @companies.each_with_index do |company, i| %>
      {
        "@type": "ListItem",
        "position": <%= @pagy.offset + i + 1 %>,
        "name": "<%= company.name.gsub('"', '\"') %>",
        "url": "<%= company_url(company) %>"
      }<%= "," unless i == @companies.size - 1 %>
      <% end %>
    ]
  }
}
</script>
<% end %>

<% if Rails.env.production? %>
  <script>
    gtag('event', 'filter_applied', {
      filter_type: 'city',
      filter_value: '<%= j @city_name %>'
    });
  </script>
<% end %>

<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

  <!-- Breadcrumb -->
  <nav class="flex mb-8 text-xs text-slate-500 font-medium uppercase tracking-wider" aria-label="Breadcrumb">
    <%= link_to "Home", root_path, class: "hover:text-indigo-600 transition-colors" %>
    <span class="mx-2 text-slate-300">›</span>
    <%= link_to "Sponsors", sponsors_path, class: "hover:text-indigo-600 transition-colors" %>
    <span class="mx-2 text-slate-300">›</span>
    <span class="text-slate-800"><%= @city_name %></span>
  </nav>

  <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-3">
    Visa Sponsors in <%= @city_name %>
  </h1>
  <p class="text-lg text-slate-500 mb-8">
    <% if @count == 1 %>
      There is <strong class="text-slate-700">1</strong> company in <%= @city_name %>
    <% else %>
      There are <strong class="text-slate-700"><%= number_with_delimiter(@count) %></strong> companies in <%= @city_name %>
    <% end %>
    licensed to sponsor short-term and long-term UK work visas, including the
    Skilled Worker, Health &amp; Care Worker, and other UKVI visa routes.
    <%= "Showing page #{@pagy.page} of #{@pagy.last}." if @pagy.last > 1 %>
  </p>

  <!-- Location Insights Dashboard -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
    
    <!-- Card 1: Route Distribution -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm shadow-slate-100/40">
      <h3 class="text-sm font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span>📋</span> Visa Routes Distribution
      </h3>
      <div class="space-y-2.5">
        <% if @route_distribution.any? %>
          <% @route_distribution.sort_by { |_, count| -count }.each do |route, count| %>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-500 truncate mr-2"><%= route %></span>
              <span class="font-semibold text-slate-800 shrink-0 bg-slate-50 border border-slate-150 px-2 py-0.5 rounded-md"><%= count %></span>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-slate-400">No active routes data available.</p>
        <% end %>
      </div>
    </div>

    <!-- Card 2: Rating Breakdown -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm shadow-slate-100/40">
      <h3 class="text-sm font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span>🏆</span> Sponsor Ratings Breakdown
      </h3>
      <div class="space-y-2.5">
        <% if @rating_breakdown.any? %>
          <% @rating_breakdown.sort_by { |r, _| r }.each do |rating, count| %>
            <div class="flex items-center justify-between text-sm">
              <div class="flex items-center gap-2">
                <%= rating_badge(rating) %>
                <span class="text-slate-500 font-medium">Rated</span>
              </div>
              <span class="font-semibold text-slate-800 bg-slate-50 border border-slate-150 px-2 py-0.5 rounded-md"><%= count %></span>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-slate-400">No active ratings data available.</p>
        <% end %>
      </div>
    </div>

    <!-- Card 3: Recent Activity -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm shadow-slate-100/40">
      <h3 class="text-sm font-bold text-slate-900 mb-4 flex items-center gap-2">
        <span>🔔</span> Recent Register Activity
      </h3>
      <div class="space-y-2.5">
        <% if @recent_events.any? %>
          <% @recent_events.each do |event| %>
            <div class="text-xs pb-2 border-b border-slate-100 last:border-0 last:pb-0">
              <div class="flex items-center justify-between font-medium text-slate-800 mb-0.5">
                <span class="truncate max-w-[170px] hover:text-indigo-650 transition-colors"><%= link_to event.company.name, company_path(event.company), class: "hover:underline" %></span>
                <span class="text-[10px] text-slate-400 font-normal shrink-0"><%= event.occurred_at.strftime("%-d %b") %></span>
              </div>
              <p class="text-slate-500 flex items-center gap-1.5">
                <span><%= event.icon %></span>
                <span class="truncate"><%= event.human_description %></span>
              </p>
            </div>
          <% end %>
        <% else %>
          <p class="text-xs text-slate-450">No recent register changes in this city.</p>
        <% end %>
      </div>
    </div>

  </div>

  <!-- Sponsor List -->
  <% if @companies.any? %>
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-8">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr class="text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
            <th scope="col" class="px-6 py-4">Company</th>
            <th scope="col" class="px-4 py-4">Routes</th>
            <th scope="col" class="px-4 py-4">Rating</th>
            <th scope="col" class="px-4 py-4">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @companies.each do |company| %>
            <tr class="group relative hover:bg-slate-50/80 transition-colors cursor-pointer" onclick="window.Turbo ? Turbo.visit('<%= company_path(company) %>') : window.location='<%= company_path(company) %>'">
              <td class="px-6 py-4">
                <%= link_to company.name, company_path(company), class: "font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors" %>
              </td>
              <td class="px-4 py-4 text-sm text-slate-500">
                <%= company.routes.join(", ") %>
              </td>
              <td class="px-4 py-4">
                <% rating = company.active_licences.first&.rating %>
                <%= rating_badge(rating) if rating %>
              </td>
              <td class="px-4 py-4">
                <%= sponsor_status_badge(company.active_sponsor?) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center shadow-sm mb-8">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-50 text-indigo-600 mb-4">
        📍
      </div>
      <h3 class="text-lg font-bold text-slate-900 mb-2">No Active Sponsors Listed in <%= @city_name %></h3>
      <p class="text-sm text-slate-500 max-w-md mx-auto mb-6 leading-relaxed">
        There are currently no active UK Home Office licensed visa sponsors registered under <%= @city_name %>. Try searching for a specific company or explore active locations.
      </p>
      <div class="flex justify-center gap-3">
        <%= link_to "Browse All Sponsors", sponsors_path, class: "px-4 py-2 bg-indigo-600 text-white text-xs font-semibold rounded-xl hover:bg-indigo-700 transition" %>
        <%= link_to "Explore Locations", locations_sponsors_path, class: "px-4 py-2 border border-slate-200 text-slate-700 text-xs font-semibold rounded-xl hover:bg-slate-50 transition" %>
      </div>
    </div>
  <% end %>

  <!-- Pagination -->
  <% if @pagy.last > 1 %>
    <nav class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm mt-8 border-t border-slate-200 pt-6" aria-label="Pagination">
      <div class="text-slate-500">
        Showing <%= @pagy.from %>–<%= @pagy.to %> of <%= number_with_delimiter(@count) %> sponsors (Page <%= @pagy.page %> of <%= @pagy.last %>)
      </div>
      <div class="flex items-center gap-1.5 flex-wrap">
        <% if @pagy.prev %>
          <%= link_to "← Previous", pagy_url_for(@pagy, @pagy.prev),
                class: "inline-flex h-9 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors mr-1" %>
        <% else %>
          <span class="inline-flex h-9 items-center justify-center rounded-lg border border-slate-100 bg-slate-50/50 px-3 text-sm font-medium text-slate-400 cursor-not-allowed mr-1">
            ← Previous
          </span>
        <% end %>

        <% @pagy.series.each do |item| %>
          <% if item.is_a?(Integer) %>
            <%= link_to item, pagy_url_for(@pagy, item),
                  class: "inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors" %>
          <% elsif item.is_a?(String) %>
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-600 border border-indigo-600 text-sm font-bold text-white shadow-sm" aria-current="page">
              <%= item %>
            </span>
          <% elsif item == :gap %>
            <span class="inline-flex h-9 w-9 items-center justify-center text-sm text-slate-400 font-medium">…</span>
          <% end %>
        <% end %>

        <% if @pagy.next %>
          <%= link_to "Next →", pagy_url_for(@pagy, @pagy.next),
                class: "inline-flex h-9 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 text-sm font-medium text-slate-600 hover:bg-slate-50 transition-colors ml-1" %>
        <% else %>
          <span class="inline-flex h-9 items-center justify-center rounded-lg border border-slate-100 bg-slate-50/50 px-3 text-sm font-medium text-slate-400 cursor-not-allowed ml-1">
            Next →
          </span>
        <% end %>
      </div>
    </nav>
  <% end %>

  <!-- City Description Section -->
  <div class="mt-12 border-t border-slate-200 pt-8">
    <div class="prose prose-slate max-w-none">
      <h2 class="text-lg font-bold text-slate-900 mb-3">Visa Sponsorship in <%= @city_name %></h2>
      <p class="text-sm text-slate-500 leading-relaxed">
        Looking for a job with visa sponsorship in <%= @city_name %>? 
        <% if @count == 1 %>
          There is currently <strong class="text-slate-700">1</strong> licensed company in <%= @city_name %>
        <% else %>
          There are currently <strong class="text-slate-700"><%= number_with_delimiter(@count) %></strong> licensed companies in <%= @city_name %>
        <% end %>
        across various sectors who have been approved by the UK government to sponsor foreign workers. 
        Whether you are looking for roles in technology, healthcare, finance, or engineering, finding an employer that already holds a valid sponsor licence is the first step toward securing your Skilled Worker or Health and Care Worker visa. Browse the table above to check the active license status, ratings, and visa routes of all companies operating in <%= @city_name %>.
      </p>
    </div>
  </div>
</div>

<% history_events = change_events.select { |event| event.event_type.in?(%w[added removed]) } %>
<% if history_events.any? %>
  <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm shadow-slate-100/40">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-slate-900">Licence History</h2>
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
        <%= pluralize(history_events.size, "event") %>
      </span>
    </div>

    <ol class="space-y-6">
      <% history_events.each do |event| %>
        <li class="relative pl-8">
          <span class="absolute left-0 top-0.5 flex h-5 w-5 items-center justify-center rounded-full ring-4 ring-white <%= event.event_type == "added" ? "bg-emerald-500" : "bg-red-500" %>">
            <% if event.event_type == "added" %>
              <svg class="h-3 w-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            <% else %>
              <svg class="h-3 w-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            <% end %>
          </span>
          <% unless event == history_events.last %>
            <span class="absolute left-2.5 top-6 -bottom-6 w-px bg-slate-150" aria-hidden="true"></span>
          <% end %>

          <p class="text-sm font-semibold text-slate-900">
            <%= event.event_type == "added" ? "Licence granted" : "Licence revoked" %>
          </p>
          <time class="text-xs text-slate-500" datetime="<%= event.occurred_at.iso8601 %>">
            <%= event.occurred_at.strftime("%-d %B %Y") %>
          </time>
        </li>
      <% end %>
    </ol>
  </div>
<% end %>

<div class="mx-auto max-w-2xl px-4 py-12 sm:px-6 lg:px-8">
  <!-- Breadcrumb -->
  <nav class="flex mb-8 text-xs text-slate-500 font-medium uppercase tracking-wider" aria-label="Breadcrumb">
    <%= link_to "Home", root_path, class: "hover:text-indigo-600 transition-colors" %>
    <span class="mx-2 text-slate-300">›</span>
    <span class="text-slate-800">Contact</span>
  </nav>

  <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-4">
    Contact Us
  </h1>
  <p class="text-lg text-slate-500 mb-10">
    Spotted incorrect data, have a question about a sponsor licence, or just fancy a chat? Drop us a line.
  </p>

  <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm text-center">
    <p class="text-sm text-slate-500 mb-2">Email us at</p>
    <a href="mailto:contact@rehangable.com" class="text-xl font-bold text-indigo-600 hover:underline">
      contact@rehangable.com
    </a>
    <p class="mt-6 text-xs text-slate-400">
      Please note VisaSponsorUK is an independent informational resource and cannot make changes to the official
      GOV.UK register — for corrections to a company's actual sponsor licence status, contact UKVI directly.
    </p>

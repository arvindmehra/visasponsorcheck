<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <!-- Breadcrumb -->
  <nav class="flex mb-6 text-xs text-slate-500 font-medium uppercase tracking-wider" aria-label="Breadcrumb">
    <%= link_to "Home", root_path, class: "hover:text-indigo-600 transition-colors" %>
    <span class="mx-2 text-slate-300">›</span>
    <span class="text-slate-800">Blog</span>
  </nav>

  <!-- Hero Header -->
  <div class="rounded-3xl bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 p-8 sm:p-12 mb-10 text-white shadow-xl">
    <div class="max-w-3xl">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 mb-4">
        UK Immigration Insights 2026
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4 text-white">
        Stay Informed on UK Visa & Compliance Rules
      </h1>
      <p class="text-indigo-100 text-base sm:text-lg mb-8 leading-relaxed">
        Expert analysis on UK Home Office policy updates, sponsor licence audits, Skilled Worker thresholds, and compliance best practices.
      </p>

      <!-- Search Form -->
      <%= form_with url: blogs_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-3" do |f| %>
        <%= f.hidden_field :category, value: @category %>
        <div class="relative flex-grow">
          <%= f.text_field :q, value: @query, placeholder: "Search topics, rules, or guidance...", 
              class: "w-full h-12 pl-4 pr-10 text-sm text-slate-900 bg-white rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>
        <%= f.submit "Search", class: "h-12 px-6 bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm rounded-xl shadow transition cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <!-- Category Pills -->
  <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 no-scrollbar">
    <% @categories.each do |cat| %>
      <% is_active = (@category == cat) || (@category.blank? && cat == "All Categories") %>
      <%= link_to cat, blogs_path(category: (cat == "All Categories" ? nil : cat), q: @query), 
          class: "px-4 py-2 text-xs sm:text-sm font-medium rounded-full whitespace-nowrap transition-all #{is_active ? 'bg-indigo-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'}" %>
    <% end %>
  </div>

  <!-- Blog Grid -->
  <% if @blogs.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @blogs.each do |blog| %>
        <article class="flex flex-col rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden hover:shadow-md hover:border-indigo-200 transition-all duration-200">
          <!-- Image -->
          <div class="aspect-video w-full bg-slate-100 relative overflow-hidden">
            <% if blog.featured_image_url.present? %>
              <img src="<%= blog.featured_image_url %>" alt="<%= blog.title %>" class="w-full h-full object-cover" loading="lazy" />
            <% else %>
              <div class="w-full h-full flex items-center justify-center bg-indigo-50 text-indigo-400 font-bold text-sm">
                VisaSponsorCheck
              </div>
            <% end %>
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-md text-[11px] font-semibold bg-indigo-600 text-white shadow-sm">
              <%= blog.category %>
            </span>
          </div>

          <!-- Content -->
          <div class="p-6 flex flex-col flex-grow">
            <div class="text-xs text-slate-400 mb-2 font-medium">
              <%= blog.published_at&.strftime("%B %d, %Y") %>
            </div>
            <h2 class="text-lg font-bold text-slate-900 mb-3 line-clamp-2 hover:text-indigo-600 transition-colors">
              <%= link_to blog.title, blog_path(blog.slug) %>
            </h2>
            <p class="text-sm text-slate-500 mb-6 line-clamp-3 leading-relaxed flex-grow">
              <%= blog.meta_description %>
            </p>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-semibold text-indigo-600 hover:text-indigo-700 flex items-center gap-1">
                Read full guide &rarr;
              </span>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-white rounded-2xl border border-slate-200">
      <h3 class="text-lg font-bold text-slate-900 mb-2">No blog posts found</h3>
      <p class="text-sm text-slate-500 mb-6">Try adjusting your search criteria or category filter.</p>
      <%= link_to "View all posts", blogs_path, class: "inline-flex px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-xl hover:bg-indigo-700 transition" %>
    </div>
  <% end %>
</div>
